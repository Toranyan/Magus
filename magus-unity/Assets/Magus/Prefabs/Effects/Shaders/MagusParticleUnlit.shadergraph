    },
    "m_SourceType": 1,
    "m_FunctionName": "Billboard_float",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float3 right = UNITY_MATRIX_I_V[0].xyz;\n    float3 up    = UNITY_MATRIX_I_V[1].xyz;\n\n    Position =\n        Pivot +\n        right * Vertex.x +\n        up * Vertex.y;"
}

